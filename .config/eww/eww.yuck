(defpoll time_hour :interval "1s" "date +'%I'")
(defpoll time_min :interval "1s" "date +'%M'")
(defpoll time_ampm :interval "1s" "date +'%p'")
(defpoll hijri_date :interval "60s" "python3 $HOME/Arch-hyperland-config/.config/waybar/modules/date_hijri.py")

(defwidget right-sidebar []
  (box :orientation "v" :space-evenly false :class "sidebar-box"
    (box :orientation "h" :space-evenly false :halign "center" :spacing 8
      (label :text time_hour :class "time-digits")
      (label :text ":" :class "time-digits")
      (label :text time_min :class "time-digits")
      (label :text time_ampm :class "time-ampm-inline")
    )
    (box :class "date-container" :halign "center"
      (label :text hijri_date :class "date-hijri")
    )
  )
)

(defwindow sidebar
  :monitor 0
  :geometry (geometry :x "20px" :y "20px" :width "320px" :height "160px" :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  :namespace "eww-sidebar"
  (right-sidebar)
)
